#!/bin/sh
# First-boot baseline for the bypass router (runs once, then removes itself).
# Bakes in everything learned on 2026-10-29:
#   - only the main router 192.168.1.1 may serve DHCP on this LAN
#   - upstream DNS = main router (not 1.1.1.1 — chinadns-ng uses it as China DNS)
#   - masquerade on lan, so clients that use .2 as gateway get return traffic
# No passwords are baked in: root stays at the lede default until set by hand.

uci -q batch <<'EOF'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.1.2'
set network.lan.netmask='255.255.255.0'
set network.lan.gateway='192.168.1.1'
delete network.lan.dns
add_list network.lan.dns='192.168.1.1'
set dhcp.lan.ignore='1'
set dhcp.lan.dhcpv4='disabled'
set dhcp.lan.dhcpv6='disabled'
set dhcp.lan.ra='disabled'
set system.@system[0].hostname='Zero3'
set system.@system[0].zonename='Asia/Shanghai'
set system.@system[0].timezone='CST-8'
EOF

# Optional second port: the first USB Ethernet adapter appears as eth1 and
# becomes WAN. With nothing plugged in these interfaces just stay down.
uci -q batch <<'EOF'
set network.wan=interface
set network.wan.device='eth1'
set network.wan.proto='dhcp'
set network.wan.metric='20'
set network.wan6=interface
set network.wan6.device='eth1'
set network.wan6.proto='dhcpv6'
EOF

# masq on the lan zone; make sure the wan zone covers wan/wan6
i=0
while uci -q get firewall.@zone[$i] >/dev/null; do
	case "$(uci -q get firewall.@zone[$i].name)" in
	lan) uci set firewall.@zone[$i].masq='1' ;;
	wan)
		uci -q del_list firewall.@zone[$i].network='wan'
		uci -q del_list firewall.@zone[$i].network='wan6'
		uci add_list firewall.@zone[$i].network='wan'
		uci add_list firewall.@zone[$i].network='wan6'
		;;
	esac
	i=$((i + 1))
done

# USB data disk (932G, user data): mount by UUID, never format.
uci -q get fstab.data_sda1 >/dev/null || {
	uci set fstab.data_sda1=mount
	uci set fstab.data_sda1.uuid='f082f09c-a290-409a-b64c-53ce95a389f5'
	uci set fstab.data_sda1.target='/mnt/sda1'
	uci set fstab.data_sda1.enabled='1'
}
uci set fstab.@global[0].check_fs='0'

uci commit
exit 0
